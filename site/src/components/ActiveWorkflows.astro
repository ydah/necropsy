---
import Icon from "./Icon.astro";
---

<article class="card active-card" id="workflows">
  <div class="card-heading">
    <div><span class="section-kicker">LIVE NOW</span><h2>Active workflows</h2></div>
    <span class="live-label"><span class="pulse-dot"></span>2 running</span>
  </div>
  <div class="active-list">
    <div class="active-row"><span class="workflow-token">CI</span><span class="active-copy"><strong>Ruby 3.4</strong><small>main · 1m 42s</small></span><span class="spinner" aria-label="In progress"></span></div>
    <div class="active-row"><span class="workflow-token">QA</span><span class="active-copy"><strong>Security audit</strong><small>release/0.3 · 34s</small></span><span class="spinner" aria-label="In progress"></span></div>
  </div>
  <a class="card-link" href="#runs">View all workflows <Icon name="arrow" size={15} /></a>
</article>
