---
import Icon from "./Icon.astro";

interface Props {
  label: string;
  value: string;
  detail: string;
  tone: "green" | "blue" | "amber";
  icon: string;
}

const { label, value, detail, tone, icon } = Astro.props;
---

<article class={`stat-card stat-${tone}`}>
  <div class="stat-topline">
    <span>{label}</span>
    <span class="stat-icon"><Icon name={icon} size={17} /></span>
  </div>
  <strong class="stat-value">{value}</strong>
  <span class="stat-detail">{detail}</span>
</article>
