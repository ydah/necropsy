---
import Icon from "./Icon.astro";
---

<article class="card health-card">
  <div class="card-heading">
    <div><span class="section-kicker">SIGNAL</span><h2>Workflow health</h2></div>
    <button class="ghost-icon" type="button" aria-label="Workflow health options"><Icon name="layers" size={17} /></button>
  </div>
  <div class="health-summary">
    <div class="health-ring"><strong>98.4<small>%</small></strong></div>
    <div><strong class="health-label">Excellent</strong><span class="health-change">+2.1% from last month</span></div>
  </div>
  <div class="health-list">
    <div class="health-line"><span>Passed</span><div class="bar"><i class="bar-green" style="width: 88%"></i></div><strong>112</strong></div>
    <div class="health-line"><span>Failed</span><div class="bar"><i class="bar-red" style="width: 8%"></i></div><strong>10</strong></div>
    <div class="health-line"><span>Cancelled</span><div class="bar"><i class="bar-muted" style="width: 5%"></i></div><strong>6</strong></div>
  </div>
</article>
