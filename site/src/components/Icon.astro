---
interface Props {
  name: string;
  size?: number;
}

const { name, size = 18 } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  aria-hidden="true"
  class="icon"
>
  {name === "grid" && <path d="M4 4h6v6H4V4Zm10 0h6v6h-6V4ZM4 14h6v6H4v-6Zm10 0h6v6h-6v-6Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />}
  {name === "activity" && <path d="M3 12h4l2.1-6 4.2 12 2.1-6H21" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />}
  {name === "layers" && <path d="m12 3 8 4.5-8 4.5-8-4.5L12 3Zm-8 9 8 4.5 8-4.5M4 16.5l8 4.5 8-4.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />}
  {name === "settings" && <path d="M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm7.4-3a7.7 7.7 0 0 0-.1-1.2l1.5-1.2-1.7-2.9-1.8.8a8.2 8.2 0 0 0-2.1-1.2L15 4h-3.4l-.3 2.3a8.2 8.2 0 0 0-2.1 1.2l-1.8-.8-1.7 2.9 1.5 1.2a7.7 7.7 0 0 0-.1 1.2c0 .4 0 .8.1 1.2l-1.5 1.2 1.7 2.9 1.8-.8c.6.5 1.3.9 2.1 1.2l.3 2.3H15l.3-2.3a8.2 8.2 0 0 0 2.1-1.2l1.8.8 1.7-2.9-1.5-1.2c.1-.4.1-.8.1-1.2Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" />}
  {name === "search" && <><circle cx="10.5" cy="10.5" r="5.8" stroke="currentColor" stroke-width="1.8" /><path d="m15 15 4.5 4.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></>}
  {name === "check" && <path d="m5 12.5 4 4L19 6.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />}
  {name === "close" && <path d="m7 7 10 10M17 7 7 17" stroke="currentColor" stroke-width="2" stroke-linecap="round" />}
  {name === "clock" && <><circle cx="12" cy="12" r="8" stroke="currentColor" stroke-width="1.7" /><path d="M12 7v5l3.2 2" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /></>}
  {name === "branch" && <><circle cx="7" cy="5" r="2" stroke="currentColor" stroke-width="1.7" /><circle cx="17" cy="19" r="2" stroke="currentColor" stroke-width="1.7" /><circle cx="17" cy="5" r="2" stroke="currentColor" stroke-width="1.7" /><path d="M7 7v5a7 7 0 0 0 7 7h1M9 5h6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" /></>}
  {name === "rocket" && <path d="M14.8 5.1c1.8-.9 3.6-.9 4.1-.4.5.5.5 2.3-.4 4.1-1.1 2.1-3.1 4.1-5.4 5.4l-3.4-3.4c1.3-2.3 3.3-4.3 5.1-5.7ZM9.7 10.8 6 10.2l-2.2 2.2 4.3 1.1M14.3 15.3l1.1 4.3 2.2-2.2-.4-3.7M8.3 16.4c-.8.8-2.3 1.2-3.3 1.2 0-1 .4-2.5 1.2-3.3M14.7 9.3h.1" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />}
  {name === "chevron" && <path d="m7 10 5 5 5-5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />}
  {name === "arrow" && <path d="M5 12h13m-5-5 5 5-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />}
  {name === "external" && <><path d="M13 5h6v6M19 5l-8 8" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /><path d="M17 13v5H5V6h5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /></>}
  {name === "plus" && <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" />}
</svg>
