---
import BaseLayout from "../layouts/BaseLayout.astro";
import FeatureCard from "../components/FeatureCard.astro";
import Icon from "../components/Icon.astro";
import SiteNav from "../components/SiteNav.astro";
import StepCard from "../components/StepCard.astro";

const base = import.meta.env.BASE_URL;

const features = [
  {
    icon: "layers",
    eyebrow: "CONSERVATIVE BY DESIGN",
    title: "Uncertainty stays visible",
    description: "Unknown dispatch, incomplete scans, and external references become blockers—not speculative deadness."
  },
  {
    icon: "grid",
    eyebrow: "PHYSICAL IDENTITIES",
    title: "Every definition gets a fair review",
    description: "Reopened classes, duplicate methods, aliases, and generated definitions remain independently reviewable."
  },
  {
    icon: "activity",
    eyebrow: "POSITIVE EVIDENCE",
    title: "Runtime data adds confidence",
    description: "TracePoint, Coverage, and Coverband-compatible observations can keep code alive. Silence never proves it is dead."
  },
  {
    icon: "search",
    eyebrow: "RUBY + RAILS AWARE",
    title: "Find the roots static tools miss",
    description: "Routes, callbacks, views, components, migrations, tests, and plain Ruby entry points are part of the analysis."
  }
];

const steps = [
  {
    number: "01",
    title: "Discover",
    description: "Parse Ruby with Prism and collect definitions, references, framework roots, and project scope."
  },
  {
    number: "02",
    title: "Build the graph",
    description: "Unify static call-site evidence, conservative dispatch, entry points, and optional runtime observations."
  },
  {
    number: "03",
    title: "Explain findings",
    description: "See reachability paths, confidence, blockers, assumptions, and the next evidence worth collecting."
  },
  {
    number: "04",
    title: "Prove removal",
    description: "Compare revisions, plan an isolated change, and run your test command before anything is removed."
  }
];
---

<BaseLayout>
  <div id="top">
    <SiteNav />

    <main>
      <section class="hero-section" aria-labelledby="hero-title">
        <div class="hero-content">
          <p class="eyebrow"><span class="eyebrow-rule"></span>OPEN SOURCE / RUBY STATIC ANALYSIS</p>
          <h1 id="hero-title">Find code you can remove.<br /><em>Know what you can't.</em></h1>
          <p class="hero-lead">Necropsy helps Ruby teams identify dead-code candidates with a conservative call graph, explicit blockers, and evidence you can review before deleting anything.</p>
          <div class="hero-actions">
            <a class="button button-primary" href={`${base}#quickstart`}>Try Necropsy <Icon name="arrow" size={17} /></a>
            <a class="button button-secondary" href="https://github.com/ydah/necropsy" target="_blank" rel="noreferrer">Explore on GitHub <Icon name="external" size={16} /></a>
          </div>
          <div class="trust-row" aria-label="Project facts">
            <span><Icon name="check" size={15} />Ruby 3.2+</span>
            <span><Icon name="check" size={15} />Prism-powered</span>
            <span><Icon name="check" size={15} />MIT licensed</span>
          </div>
        </div>

        <div class="hero-console" aria-label="Example Necropsy analysis output">
          <div class="console-topbar"><span class="console-dots"><i></i><i></i><i></i></span><span>necropsy / analyze</span><span class="console-label">EXAMPLE</span></div>
          <pre><code><span class="code-muted">$</span> bundle exec necropsy analyze --root .

<span class="code-heading">ANALYSIS HEALTH</span>
  <span class="code-positive">complete</span>   428 definitions · 1,204 references

<span class="code-heading">REVIEW CANDIDATES</span>
  <span class="code-candidate">unreachable</span>     LegacyService#unused
  <span class="code-blocked">blocked</span>          ReportExporter#call
  <span class="code-test">test_only_reachable</span>  TestHelpers#fixture

<span class="code-muted">→ inspect evidence before removal</span></code></pre>
        </div>
      </section>

      <section class="signal-strip" aria-label="Problems Necropsy keeps visible">
        <p>Dead code is easy to suspect.<br /><strong>Safe removal is the real problem.</strong></p>
        <div class="signal-list">
          <span><i></i>Unknown dispatch</span>
          <span><i></i>Framework entry points</span>
          <span><i></i>Incomplete source scans</span>
        </div>
      </section>

      <section class="section-block" id="why" aria-labelledby="why-title">
        <div class="section-heading">
          <p class="eyebrow"><span class="eyebrow-rule"></span>WHY NECROPSY</p>
          <h2 id="why-title">A dead-code detector that<br /><em>shows its work.</em></h2>
          <p>Most tools stop at a list of names. Necropsy keeps the reasoning attached, so a candidate is a starting point for review—not a command to delete.</p>
        </div>
        <div class="feature-grid">
          {features.map((feature) => <FeatureCard {...feature} />)}
        </div>
      </section>

      <section class="section-block process-section" id="how-it-works" aria-labelledby="process-title">
        <div class="section-heading compact-heading">
          <p class="eyebrow"><span class="eyebrow-rule"></span>HOW IT WORKS</p>
          <h2 id="process-title">From suspicion<br /><em>to evidence.</em></h2>
        </div>
        <div class="steps-grid">
          {steps.map((step) => <StepCard {...step} />)}
        </div>
        <div class="explanation-panel">
          <div class="explanation-mark"><Icon name="layers" size={22} /></div>
          <div>
            <p class="card-eyebrow">THE SAFETY CONTRACT</p>
            <h3>Confidence ranks evidence. It does not prove removal is safe.</h3>
            <p>Actionability and analysis health make the difference between a review candidate, a blocked result, and an incomplete scan visible in every report.</p>
          </div>
        </div>
      </section>

      <section class="quickstart-section" id="quickstart" aria-labelledby="quickstart-title">
        <div class="quickstart-copy">
          <p class="eyebrow"><span class="eyebrow-rule"></span>QUICK START</p>
          <h2 id="quickstart-title">Put the first report<br /><em>in your review queue.</em></h2>
          <p>Add Necropsy to your development or test group, generate a baseline, and run an analysis against the project you already have.</p>
          <a class="text-link" href="https://github.com/ydah/necropsy#quick-start" target="_blank" rel="noreferrer">Read the full documentation <Icon name="arrow" size={16} /></a>
        </div>
        <div class="quickstart-code">
          <div class="code-line"><span class="code-comment"># Gemfile</span></div>
          <div class="code-line"><span class="code-keyword">group</span> <span class="code-string">:development, :test</span> <span class="code-keyword">do</span></div>
          <div class="code-line code-indent"><span class="code-function">gem</span> <span class="code-string">"necropsy"</span>, <span class="code-symbol">require:</span> <span class="code-string">false</span></div>
          <div class="code-line"><span class="code-keyword">end</span></div>
          <div class="code-divider"></div>
          <div class="code-line"><span class="code-prompt">$</span> bundle exec necropsy baseline --root .</div>
          <div class="code-line"><span class="code-prompt">$</span> bundle exec necropsy analyze --root . --format human</div>
          <div class="code-line code-muted"># review findings, blockers, and paths</div>
        </div>
      </section>

      <section class="closing-section" aria-labelledby="closing-title">
        <p class="eyebrow"><span class="eyebrow-rule"></span>MAKE CLEANUP REVIEWABLE</p>
        <h2 id="closing-title">Less mystery in the codebase.<br /><em>More confidence in the diff.</em></h2>
        <p>Necropsy is open source and built for teams that want to remove code without losing the context that made it hard to trust.</p>
        <div class="hero-actions closing-actions">
          <a class="button button-primary" href="https://github.com/ydah/necropsy" target="_blank" rel="noreferrer">View the repository <Icon name="external" size={16} /></a>
          <a class="button button-secondary" href="https://rubygems.org/gems/necropsy" target="_blank" rel="noreferrer">View the gem <Icon name="arrow" size={16} /></a>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div><a class="brand footer-brand" href={`${base}#top`}><span class="brand-mark" aria-hidden="true"><span></span><span></span><span></span></span><span>Necropsy</span></a><p>Safety-first dead-code analysis for Ruby.</p></div>
      <div class="footer-links"><a href="https://github.com/ydah/necropsy" target="_blank" rel="noreferrer">GitHub</a><a href="https://rubygems.org/gems/necropsy" target="_blank" rel="noreferrer">RubyGems</a><a href="https://opensource.org/licenses/MIT" target="_blank" rel="noreferrer">MIT License</a></div>
    </footer>
  </div>
</BaseLayout>
