---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Actions · Necropsy",
  description = "A focused GitHub Actions dashboard for monitoring workflow health."
} = Astro.props;
const base = import.meta.env.BASE_URL;
const favicon = `${base.replace(/\/$/, "")}/favicon.svg`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#0f172a" />
    <meta name="description" content={description} />
    <link rel="icon" href={favicon} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
