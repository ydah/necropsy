---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Necropsy · Safety-first dead-code analysis for Ruby",
  description = "Find Ruby dead-code candidates with conservative analysis, explicit blockers, and evidence you can review before removal."
} = Astro.props;
const base = import.meta.env.BASE_URL;
const favicon = `${base.replace(/\/$/, "")}/favicon.svg`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#f0f9ff" />
    <meta name="description" content={description} />
    <link rel="icon" href={favicon} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
